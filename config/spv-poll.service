[Unit]
Description=iConta SPV poll e-Factura (F178 - stareMesaj/descarcare recipisa)
After=network.target postgresql.service

[Service]
Type=oneshot
User=costin
WorkingDirectory=/home/costin/iconta_nou
EnvironmentFile=/home/costin/.iconta/db.env
EnvironmentFile=/home/costin/.iconta/api_keys.env
ExecStart=/opt/iconta/venv/bin/python3 -m core.spv_poll
StandardOutput=append:/home/costin/iconta_nou/spv_poll.log
StandardError=append:/home/costin/iconta_nou/spv_poll.log

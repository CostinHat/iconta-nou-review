# capturile de referinta ale uneltelor vizuale (decizia lui Costin, 26.08.2026)
# Un baseline vizual e o referinta LOCALA, nu un artefact partajat: doua statii cu randari
# usor diferite ar produce diferente care nu sunt regresii. Iar ~2 MB de PNG care cresc la
# fiecare recapturare sunt cost permanent pentru ceva regenerabil cu `baseline_scan.py`.
# Starea de dinainte era cea mai proasta dintre cele trei: 5 urmarite din 14.
frontend_test/vizual/baseline/

# backup-uri de la patch-uri (nu versionam - git e istoricul acum)
*.bak_*
*.bak

# cache Python
__pycache__/
*.pyc
*.pyo

# loguri
*.log
uvicorn.log

# arhive / build artefacte
*.tar.gz
*.zip

# secrete (sunt in ~/.iconta/ oricum, dar exclud preventiv)
*.env
api_keys.env
db.env
*.conf

# temporare
*.tmp
*.swp
.DS_Store
*.bak2_*
*.bak[0-9]*

# unelte de-o folosinta (patch-uri aplicate deja, arhivate local)
_arhiva_patchuri/
patch*.py
log_arhiva/

# brief-uri de lucru Costin (nu cod, nu se versioneaza)
BRIEF_CODE_*.md

# intarire secrete/artefacte (adaugat la pregatirea repo GitHub)
.venv/
*.key
*.pem
*.p12
*.pfx
id_*
*.sqlite

# playwright + pyee: driver/node depaseste 100MB (limita GitHub) - harness headless reproductibil cu: pip install playwright && playwright install chromium
venv/bin/playwright
venv/lib/python3.12/site-packages/playwright/
venv/lib/python3.12/site-packages/playwright-*.dist-info/
venv/lib/python3.12/site-packages/pyee/
venv/lib/python3.12/site-packages/pyee-*.dist-info/
.lant_tmp/

# Jurnalul portii (23.08.2026): urma respingerilor, ca sa se poata raspunde la
# "a prins vreodata garda X o regresie reala?". NU se versioneaza - e o urma locala.
.poarta_jurnal.log

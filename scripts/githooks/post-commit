#!/bin/sh
# post-commit — CABLEAZA publicarea dupa fiecare mutare a lui main (CLAUDE.md §6, versiunea 23.10.2026; inainte §2.3 pct.8).
# [08.09.2026] PATRU destinatii, nu trei: origin/main, public/main, backup/lant-<zi>, statica publicata.
#
# `reference-transaction` impune DEJA poarta verde (verdictul VERDE al lui `scripts/poarta_lot.sh` pentru SHA-ul tinta, din 15.10.2026;
# inainte commit-msg / pre-commit). Daca acest hook ruleaza pe main, poarta a trecut si
# commit-ul exista. Ce lipsea era GARDUL care publica - o regula a carei absenta e definita ca defectiune
# (pct.8) dar care nu avea niciun mecanism. Publicarea nu mai depinde de memoria executorului.
#
# Contract, IDENTIC pe ambele tinte (origin/main SI backup/lant-<data>): fast-forward; NICIODATA --force;
# esec = banner + sentinela (.git/PUSH_MAIN_ESUAT, .git/PUSH_BACKUP_ESUAT), niciodata tacut. Nu atinge poarta.

set -u
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
[ "$BRANCH" = "main" ] || exit 0   # alte ramuri de lucru raman in seama executorului

HEAD_SHA=$(git rev-parse HEAD)

banner() {   # $1=tinta  $2=sentinela  $3=motiv  $4=remediu
    echo ""
    echo "############################################################"
    echo "## [post-commit] PUBLICARE pe $1 NEFACUTA: $3"
    echo "## Commit-ul e local, dar NU pe $1."
    echo "## Rezolva ACUM: $4"
    echo "## Sentinela $2 scrisa - raportul NU e 'incheiat' cat timp exista."
    echo "############################################################"
    echo ""
    printf '%s\n' "$3" > "$2"
}

# ---------- 1. origin/main (fast-forward, FARA --force) ----------
S_MAIN=".git/PUSH_MAIN_ESUAT"; rm -f "$S_MAIN"
if ! git fetch -q origin main 2>/dev/null; then
    banner "origin/main" "$S_MAIN" "fetch a esuat (retea/auth)" \
           "verifica reteaua/cheia SSH, apoi: git push origin main"
elif [ "$HEAD_SHA" = "$(git rev-parse origin/main 2>/dev/null)" ]; then
    :   # la zi
elif ! git merge-base --is-ancestor origin/main HEAD 2>/dev/null; then
    banner "origin/main" "$S_MAIN" "origin/main a avansat sub tine - NU e fast-forward" \
           "git pull --rebase origin main (NU forta); urmatorul commit republica singur"
elif git push origin main > /tmp/push_main.log 2>&1; then
    echo "[post-commit] publicat pe origin/main: $(git rev-parse --short HEAD)"
else
    banner "origin/main" "$S_MAIN" "git push a esuat: $(tail -1 /tmp/push_main.log)" \
           "citeste /tmp/push_main.log, rezolva cauza, apoi: git push origin main"
fi

# ---------- 1b. public/main (fast-forward, FARA --force) ----------
# [08.09.2026] Repo-ul PUBLIC (`CostinHat/iconta-nou-review`) se publica automat, langa `origin`.
# Contract IDENTIC cu pasul 1. NU intra in four-way: four-way-ul ramane verificarea pe `origin`,
# fiindca `public` e o a doua destinatie, nu un al cincilea brat — o retea cazuta spre GitHub n-are
# voie sa faca sa para ca publicarea locala n-a reusit.
S_PUB=".git/PUSH_PUBLIC_ESUAT"; rm -f "$S_PUB"
if ! git remote get-url public >/dev/null 2>&1; then
    :   # remote-ul `public` nu exista pe instalarea asta — nu e o eroare, e o instalare fara el
elif ! git fetch -q public main 2>/dev/null; then
    banner "public/main" "$S_PUB" "fetch a esuat (retea/auth)" \
           "verifica reteaua/cheia SSH, apoi: git push public main"
elif [ "$HEAD_SHA" = "$(git rev-parse public/main 2>/dev/null)" ]; then
    :   # la zi
elif ! git merge-base --is-ancestor public/main HEAD 2>/dev/null; then
    banner "public/main" "$S_PUB" "public/main a avansat sub tine - NU e fast-forward" \
           "git fetch public && verifica; NU se forteaza din hook"
elif git push public main > /tmp/push_public.log 2>&1; then
    echo "[post-commit] publicat pe public/main: $(git rev-parse --short HEAD)"
else
    banner "public/main" "$S_PUB" "git push a esuat: $(tail -1 /tmp/push_public.log)" \
           "citeste /tmp/push_public.log, rezolva cauza, apoi: git push public main"
fi

# ---------- 2. backup/lant-<data> (fast-forward, FARA --force) ----------
S_BK=".git/PUSH_BACKUP_ESUAT"; rm -f "$S_BK"
BK="backup/lant-$(date +%Y-%m-%d)"
git fetch -q origin "$BK" 2>/dev/null || true
REMOTE_BK=$(git ls-remote origin "$BK" 2>/dev/null | cut -f1)
if [ -z "$REMOTE_BK" ]; then
    # ramura zilei nu exista inca -> o creeaza (fast-forward din nimic, fara force)
    if git push origin "HEAD:refs/heads/$BK" > /tmp/push_backup.log 2>&1; then
        echo "[post-commit] backup creat: $BK -> $(git rev-parse --short HEAD)"
    else
        banner "$BK" "$S_BK" "creare a esuat: $(tail -1 /tmp/push_backup.log)" \
               "citeste /tmp/push_backup.log, apoi: git push origin HEAD:$BK"
    fi
elif [ "$HEAD_SHA" = "$REMOTE_BK" ]; then
    :   # la zi
elif git merge-base --is-ancestor "$REMOTE_BK" HEAD 2>/dev/null; then
    if git push origin "HEAD:refs/heads/$BK" > /tmp/push_backup.log 2>&1; then
        echo "[post-commit] backup publicat: $BK -> $(git rev-parse --short HEAD)"
    else
        banner "$BK" "$S_BK" "git push a esuat: $(tail -1 /tmp/push_backup.log)" \
               "citeste /tmp/push_backup.log, apoi: git push origin HEAD:$BK"
    fi
else
    banner "$BK" "$S_BK" "$BK a divergat (nu e fast-forward)" \
           "verifica ramura; NU se forteaza din hook - muta backup-ul manual, constient"
fi

# ---------- 2b. PUBLICAREA STATICULUI (R118) — făcută la pasul 3, NUMAI odată cu restartul ----------
# CE SE SERVESTE nu mai e CE E IN LUCRU: /static se monteaza din ../iconta_publicat/static, scris
# de aici, din HEAD. Deci un .js ajunge la un browser DOAR dupa ce a trecut poarta si a intrat in
# commit. Publicarea are propria poarta de sintaxa (node --check pe fiecare .js) si REFUZA sa
# inlocuiasca ce se serveste daca vreunul nu se parseaza.
#
# ORDINEA CONTEAZA: publicarea vine INAINTE de restart. Invers, procesul nou ar porni pe statica
# veche, iar Python-ul si JS-ul ar descrie doua versiuni diferite ale aplicatiei. Esec = sentinela
# + banner, ca la push-uri; NICIODATA tacut.
# [10.10.2026, lotul „Retestul plasei”] ...si se publică NUMAI când procesul viu preia același commit: cu restartul oprit de o migrare
# nerulată, statica nouă ajungea peste backendul vechi (văzut la 445f9932: JS-ul commitului servit de procesul pe 60c716d1). Cu
# restartul oprit, statica rămâne a commitului care rulează; rulatorul migrărilor o publică înaintea restartului lui.
S_PS=".git/PUBLICARE_STATIC_ESUATA"; rm -f "$S_PS"
publica_statica() {
    if "$PWD/venv/bin/python" scripts/publica_static.py > /tmp/publica_static.log 2>&1; then
        echo "[post-commit] static publicat: $(tail -1 /tmp/publica_static.log)"
    else
        banner "static publicat" "$S_PS" "publicarea staticului a esuat: $(tail -1 /tmp/publica_static.log 2>/dev/null)"            "citeste /tmp/publica_static.log (de obicei: un .js care nu se parseaza), repara, apoi: ./venv/bin/python scripts/publica_static.py"
    fi
}

# ---------- 3. restart NECONDITIONAT: procesul viu preia HEAD dupa ORICE publicare ----------
# NU se inspecteaza tipul commitului (runtime / docs / CSV / JS). Conditionarea pe tip a produs
# divergenta RUNNING != HEAD (un commit de docs a lasat procesul pe commitul anterior). Regula
# CLAUDE.md §2.3 pct.10: dupa orice publicare din lant, procesul viu incarca HEAD - fara exceptii,
# fara liste de tipuri. Gardat de core/test_publicare_restart_neconditionat.py (cade daca reapare
# orice conditionare pe continut). Esec = sentinela + banner, niciodata tacut (ca push-urile).
#
# [09.10.2026, comanda Costin pct.2 — PIVOT, singura conditie admisa] „Daca un commit contine o migrare nerulata pe productie,
# aplicatia nu reporneste.” Conditia NU e pe tipul commitului, ci pe STAREA productiei: `core.migrari_registru verifica` confrunta
# migrarile din HEAD cu registrul `public.migrari_rulate` si schemele firmelor cu `tenant_template.sql` din HEAD. FAIL-CLOSED: daca
# nu se poate sti, nu reporneste. Rulatorul (`... ruleaza --productie <fisier>`) reporneste el, dupa ultima migrare lipsa.
# Gardat de core/test_publicare_restart_neconditionat.py (verificarea e singura conditie; alta reaparuta -> pica).
S_RS=".git/RESTART_ESUAT"; rm -f "$S_RS"
S_MG=".git/RESTART_OPRIT_MIGRARE"; rm -f "$S_MG"
if "$PWD/venv/bin/python" -m core.migrari_registru verifica "$HEAD_SHA" > /tmp/migrari_verifica.log 2>&1; then
    publica_statica   # statica commitului, înaintea restartului (pasul 2b)
    if sudo -n systemctl restart iconta-nou > /tmp/restart_iconta.log 2>&1; then
        echo "[post-commit] iconta-nou restartat -> procesul viu preia $(git rev-parse --short HEAD)"
    else
        banner "iconta-nou (restart)" "$S_RS" "restart a esuat: $(tail -1 /tmp/restart_iconta.log 2>/dev/null)" \
               "verifica sudoers (systemctl restart iconta-nou), apoi ruleaza: sudo systemctl restart iconta-nou"
    fi
else
    cat /tmp/migrari_verifica.log
    echo "[post-commit] static NEpublicat: procesul viu ramane pe commitul anterior pana la migrare; rulatorul publica statica inaintea restartului"
    banner "iconta-nou (restart OPRIT)" "$S_MG" "productia nu are inca migrarile commitului (lista de mai sus)" \
           "ruleaza fiecare migrare listata: ./venv/bin/python -m core.migrari_registru ruleaza --productie <fisier> — dupa ultima, rulatorul reporneste aplicatia"
fi

# ---------- 4. FOUR-WAY VERIFICAT, si push de RECUPERARE daca lipseste bratul remote ----------
# [12.10.2026] four-way-ul (confirmarea celor patru brate + reincercarea push-ului pe main) traieste in scripts/githooks/four-way:
# il cheama si rulatorul migrarilor dupa restartul amanat, ca sentinela sa nu ramana dupa ce bratele s-au inchis.
sh "$(dirname "$0")/four-way"

exit 0

#!/bin/sh
# post-commit — CABLEAZA publicarea dupa fiecare mutare a lui main (CLAUDE.md §6, versiunea 23.10.2026; inainte §2.3 pct.8).
# [08.09.2026] PATRU destinatii, nu trei: origin/main, public/main, backup/lant-<zi>, statica publicata.
#
# `reference-transaction` impune DEJA poarta verde (verdictul VERDE al lui `scripts/poarta_lot.sh` pentru SHA-ul tinta, din 15.10.2026;
# inainte commit-msg / pre-commit). Daca acest hook ruleaza pe main, poarta a trecut si
# commit-ul exista. Ce lipsea era GARDUL care publica - o regula a carei absenta e definita ca defectiune
# (pct.8) dar care nu avea niciun mecanism. Publicarea nu mai depinde de memoria executorului.
#
# Contract, IDENTIC pe ambele tinte (origin/main SI backup/lant-<data>): fast-forward; NICIODATA --force;
# esec = banner + sentinela (.git/PUSH_MAIN_ESUAT, .git/PUSH_BACKUP_ESUAT), niciodata tacut. Nu atinge poarta.

set -u
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
# [16.1-C3, pct.3] contractul la început: la primul commit al unei ramuri lucru/* după merge-base cu main, HOOK-ul (nu Code) rulează `publica_lot.py --proba` — rândul pasului a)
# din jurnal_verificare.csv pe commitul de bază, cu captură; scrie faza „proba_contract” în jurnal. Un lot fără „proba_contract” verde = STOP la publicare.
case "$BRANCH" in lucru/*)
    if [ "$(git rev-list --count main..HEAD 2>/dev/null)" = "1" ]; then
        PYP=./venv/bin/python; [ -x "$PYP" ] || PYP=python3
        "$PYP" scripts/publica_lot.py --proba || echo "[post-commit] proba_contract ROȘIE: lotul nu se poate publica până la rândul pasului a) pe commitul de bază"
    fi ;;
esac
[ "$BRANCH" = "main" ] || exit 0   # alte ramuri de lucru raman in seama executorului

HEAD_SHA=$(git rev-parse HEAD)

banner() {   # $1=tinta  $2=sentinela  $3=motiv  $4=remediu
    echo ""
    echo "############################################################"
    echo "## [post-commit] PUBLICARE pe $1 NEFACUTA: $3"
    echo "## Commit-ul e local, dar NU pe $1."
    echo "## Rezolva ACUM: $4"
    echo "## Sentinela $2 scrisa - raportul NU e 'incheiat' cat timp exista."
    echo "############################################################"
    echo ""
    printf '%s\n' "$3" > "$2"
}

# ---------- 1. origin/main (fast-forward, FARA --force) ----------
S_MAIN=".git/PUSH_MAIN_ESUAT"; rm -f "$S_MAIN"
if ! git fetch -q origin main 2>/dev/null; then
    banner "origin/main" "$S_MAIN" "fetch a esuat (retea/auth)" \
           "verifica reteaua/cheia SSH, apoi: git push origin main"
elif [ "$HEAD_SHA" = "$(git rev-parse origin/main 2>/dev/null)" ]; then
    :   # la zi
elif ! git merge-base --is-ancestor origin/main HEAD 2>/dev/null; then
    banner "origin/main" "$S_MAIN" "origin/main a avansat sub tine - NU e fast-forward" \
           "git pull --rebase origin main (NU forta); urmatorul commit republica singur"
elif git push origin main > /tmp/push_main.log 2>&1; then
    echo "[post-commit] publicat pe origin/main: $(git rev-parse --short HEAD)"
else
    banner "origin/main" "$S_MAIN" "git push a esuat: $(tail -1 /tmp/push_main.log)" \
           "citeste /tmp/push_main.log, rezolva cauza, apoi: git push origin main"
fi

# ---------- 1b. public/main (fast-forward, FARA --force) ----------
# [08.09.2026] Repo-ul PUBLIC (`CostinHat/iconta-nou-review`) se publica automat, langa `origin`.
# Contract IDENTIC cu pasul 1. NU intra in four-way: four-way-ul ramane verificarea pe `origin`,
# fiindca `public` e o a doua destinatie, nu un al cincilea brat — o retea cazuta spre GitHub n-are
# voie sa faca sa para ca publicarea locala n-a reusit.
S_PUB=".git/PUSH_PUBLIC_ESUAT"; rm -f "$S_PUB"
if ! git remote get-url public >/dev/null 2>&1; then
    :   # remote-ul `public` nu exista pe instalarea asta — nu e o eroare, e o instalare fara el
elif ! git fetch -q public main 2>/dev/null; then
    banner "public/main" "$S_PUB" "fetch a esuat (retea/auth)" \
           "verifica reteaua/cheia SSH, apoi: git push public main"
elif [ "$HEAD_SHA" = "$(git rev-parse public/main 2>/dev/null)" ]; then
    :   # la zi
elif ! git merge-base --is-ancestor public/main HEAD 2>/dev/null; then
    banner "public/main" "$S_PUB" "public/main a avansat sub tine - NU e fast-forward" \
           "git fetch public && verifica; NU se forteaza din hook"
elif git push public main > /tmp/push_public.log 2>&1; then
    echo "[post-commit] publicat pe public/main: $(git rev-parse --short HEAD)"
else
    banner "public/main" "$S_PUB" "git push a esuat: $(tail -1 /tmp/push_public.log)" \
           "citeste /tmp/push_public.log, rezolva cauza, apoi: git push public main"
fi

# ---------- 2. backup/lant-<data> (fast-forward, FARA --force) ----------
S_BK=".git/PUSH_BACKUP_ESUAT"; rm -f "$S_BK"
BK="backup/lant-$(date +%Y-%m-%d)"
git fetch -q origin "$BK" 2>/dev/null || true
REMOTE_BK=$(git ls-remote origin "$BK" 2>/dev/null | cut -f1)
if [ -z "$REMOTE_BK" ]; then
    # ramura zilei nu exista inca -> o creeaza (fast-forward din nimic, fara force)
    if git push origin "HEAD:refs/heads/$BK" > /tmp/push_backup.log 2>&1; then
        echo "[post-commit] backup creat: $BK -> $(git rev-parse --short HEAD)"
    else
        banner "$BK" "$S_BK" "creare a esuat: $(tail -1 /tmp/push_backup.log)" \
               "citeste /tmp/push_backup.log, apoi: git push origin HEAD:$BK"
    fi
elif [ "$HEAD_SHA" = "$REMOTE_BK" ]; then
    :   # la zi
elif git merge-base --is-ancestor "$REMOTE_BK" HEAD 2>/dev/null; then
    if git push origin "HEAD:refs/heads/$BK" > /tmp/push_backup.log 2>&1; then
        echo "[post-commit] backup publicat: $BK -> $(git rev-parse --short HEAD)"
    else
        banner "$BK" "$S_BK" "git push a esuat: $(tail -1 /tmp/push_backup.log)" \
               "citeste /tmp/push_backup.log, apoi: git push origin HEAD:$BK"
    fi
else
    banner "$BK" "$S_BK" "$BK a divergat (nu e fast-forward)" \
           "verifica ramura; NU se forteaza din hook - muta backup-ul manual, constient"
fi

# ---------- restartul producției și four-way: NU mai sunt aici (16.1-C3, pct.7) ----------
# Restartul producției îl face numai scripts/publica_prod.sh, chemat de scripts/publica_lot.sh ca pas „restart” după push și înaintea sfârșitului fazei „publicare”; scriptul refuză fără
# verdictul PASS pentru HEAD. Statica publicată și four-way-ul (confirmarea celor patru brațe) merg tot acolo, după restart. Un commit făcut direct pe main nu mai repornește nimic.
exit 0

#!/bin/sh
# reference-transaction — GARDA PE `main`. `main` din `~/iconta_nou` e versiunea publicată: orice mutare a lui `refs/heads/main` (commit,
# fast-forward, reset, pull, ștergere) PUBLICĂ (post-commit) sau schimbă ce e pe disc lângă procesul viu (regim pilot, 14.10.2026).
#
# REGULA (23.10.2026, CLAUDE.md §6: „După poarta verde, Code publică imediat, fără să aștepte confirmare”; DECIZII 23.10.2026
# „Comanda 12.1”): `refs/heads/main` se mută la un SHA NUMAI dacă `<git-common-dir>/poarta_verdicte.log` are rândul `VERDE <sha> …`,
# scris de `scripts/poarta_lot.sh` — verdictul rulării complete (`VERDE <sha> <ramura> <data>`) SAU cel compus din rularea completă
# anterioară plus rerularea țintită (`VERDE <sha> <ramura> <data> compus:<X>`, CLAUDE.md §5). Fără verdict VERDE pentru acel SHA ->
# tranzacția e REFUZATĂ (git o anulează, nimic nu se mută). Ștergerea lui `main` e refuzată mereu.
#
# RADIAT 23.10.2026: aprobarea scrisă `<git-common-dir>/APROBARE_MAIN` (`sha:` + `aprobat:`, comanda Costin 14.10.2026 pct.2) și
# consumarea ei la reușită (`APROBARE_MAIN.folosita-<sha>`). Verdictul VERDE e singura condiție; un fișier `APROBARE_MAIN` rămas pe disc
# nu mai e citit, nici mutat. (Istoric: 14.10 aprobarea; 15.10 „main acceptă un commit doar dacă jurnalul porții îl arată verde” s-a
# adăugat lângă ea; 23.10 aprobarea a ieșit.)
# Lucrul se face pe ramuri, în worktree; publicarea = fast-forward la SHA-ul verde + post-commit.
# Gard: core/test_garda_main.py (depozit temporar; mutațiile „verdictul nu se cere”, „ștergerea trece”, „aprobarea scrisă cerută înapoi”
# -> ROȘU).
STARE="$1"
[ "$STARE" = "prepared" ] || exit 0
COMUN=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
JV="$COMUN/poarta_verdicte.log"
ZERO=0000000000000000000000000000000000000000
COD=0
while read -r VECHI NOU REF; do
    [ "$REF" = "refs/heads/main" ] || continue
    # la ștergere git poate trimite vechiul SHA ca zero (nu-l verifică): „vechi = nou” ar sări-o — se tratează înainte
    [ "$NOU" != "$ZERO" ] && [ "$VECHI" = "$NOU" ] && continue
    if [ "$NOU" = "$ZERO" ]; then
        echo "" >&2
        echo "############################################################" >&2
        echo "## [garda main] REFUZAT: ștergerea lui refs/heads/main (versiunea publicată)." >&2
        echo "############################################################" >&2
        COD=1
    elif ! grep -q "^VERDE $NOU " "$JV" 2>/dev/null; then
        echo "" >&2
        echo "############################################################" >&2
        echo "## [garda main] REFUZAT: refs/heads/main -> ${NOU} fără poarta VERDE a lotului pentru acest SHA." >&2
        echo "## main = versiunea publicată. Lucrează pe o ramură; la închiderea lotului: sh scripts/poarta_lot.sh" >&2
        echo "## (sau --compus, după o rulare completă roșie). Verdictul în $JV." >&2
        echo "############################################################" >&2
        COD=1
    fi
done
exit $COD

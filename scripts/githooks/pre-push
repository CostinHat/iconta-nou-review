#!/bin/sh
# pre-push — GARDA pe împingerea spre `main` a oricărui remote (comanda 16.1, pct.4): un SHA se împinge pe refs/heads/main numai dacă are VERDE (poarta, rularea
# completă) ȘI `PASS` (scripts/publica_lot.sh) în jurnalele din <git-common-dir>. Completează reference-transaction, care păzește `main` local. Alte ramuri (backup/…, lucru/…) trec.
. "$(dirname "$0")/verde-prin-pass.sh"
COMUN=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
ZERO=0000000000000000000000000000000000000000
COD=0
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    [ "$REMOTE_REF" = "refs/heads/main" ] || continue
    [ "$LOCAL_SHA" = "$ZERO" ] && { echo "[pre-push] REFUZAT: ștergerea lui main de pe remote." >&2; COD=1; continue; }
    if ! grep -q "^PASS $LOCAL_SHA " "$COMUN/publica_verdicte.log" 2>/dev/null || ! verde_pe_head "$LOCAL_SHA" "$COMUN/poarta_verdicte.log" "$COMUN/publica_verdicte.log"; then
        echo "[pre-push] REFUZAT: $LOCAL_SHA nu are VERDE (poarta) și PASS (scripts/publica_lot.sh) — nu se împinge pe main." >&2
        COD=1
    fi
done
exit $COD

#!/bin/sh
# Poarta mecanica pre-commit (iConta). Ruleaza SUITA INTREAGA (pytest) + verificator_conformitate.py
# la FIECARE commit, MEREU, fara argumente si fara subset - nu se poate ocoli tastand alt pytest.
# Respinge commit-ul daca pytest nu iese 0 SAU verificatorul nu da "TOTAL: 0".
#
# Instalare (o singura data, per clona - .git/hooks NU intra in git):
#     git config core.hooksPath scripts/githooks
#
# De ce (31.07.2026): un `pytest && git commit` a lasat sa treaca un commit ROSU pentru ca pytest
# rulase pe un subset (doar core/). O poarta care depinde de ce comanda tastezi nu e poarta.
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
PY=./venv/bin/python
[ -x "$PY" ] || PY=python3
RUFF=./venv/bin/ruff
if [ -x "$RUFF" ]; then
    echo "[pre-commit] ruff (undefined-name F821/F822/F823)..."
    if ! "$RUFF" check . > /tmp/precommit_ruff.log 2>&1; then
        echo "[pre-commit] RESPINS: ruff a gasit nume nedefinite / crash latent (F821/F822/F823):"
        cat /tmp/precommit_ruff.log
        exit 1
    fi
    echo "[pre-commit] ruff OK."
else
    echo "[pre-commit] ATENTIE: ruff neinstalat in venv - poarta undefined-name (F821/F822/F823) SARITA. Ruleaza: ./venv/bin/pip install ruff"
fi
echo "[pre-commit] pytest (suita intreaga, ~32s)..."
"$PY" -m pytest -q > /tmp/precommit_pytest.log 2>&1
RC=$?
tail -1 /tmp/precommit_pytest.log
if [ "$RC" -ne 0 ]; then
    # JURNALUL PORTII (23.08.2026). Un test rosu OPRESTE commitul, omul repara, si ce ajunge in
    # istorie e deja verde - deci, PRIN CONSTRUCTIE, o garda care prinde o regresie nu lasa nicio
    # urma. Masurat: in 1.725 de commituri, patru citeaza un test, si toate patru repara TESTUL, nu
    # ceva prins de el. Intrebarea „a prins vreodata garda X o regresie reala?" n-avea cum sa aiba
    # raspuns. De aici incolo are: fiecare respingere se scrie, cu data, testele picate si CE ERA
    # IN STAGE (nu mesajul: la pre-commit el nu exista inca - vezi nota de mai jos). Jurnalul NU intra in istoric (e in .gitignore) - nu e un artefact de
    # versionat, e o urma care exista.
    JURNAL="$ROOT/.poarta_jurnal.log"
    {
        echo "=== $(date -Is) RESPINS pytest exit $RC"
        echo "    stage: $(git diff --cached --name-only | tr '\n' ' ' | cut -c1-160)"
        # NU se scrie mesajul commitului: cu `git commit -F`, .git/COMMIT_EDITMSG inca
        # nu e scris la momentul pre-commit, deci ar contine mesajul commitului PRECEDENT.
        # Dovedit pe prima respingere reala (23.08): scria prima linie a lui HEAD.
        echo "    HEAD : $(git rev-parse --short HEAD 2>/dev/null)"
        grep -E "^(FAILED|ERROR) " /tmp/precommit_pytest.log 2>/dev/null | sed "s/^/    /" | head -40
        tail -1 /tmp/precommit_pytest.log | sed "s/^/    /"
    } >> "$JURNAL"
    echo "[pre-commit] RESPINS: pytest exit $RC (suita rosie). Log complet: /tmp/precommit_pytest.log"
    echo "[pre-commit] consemnat in .poarta_jurnal.log ($(grep -c '^=== ' "$JURNAL" 2>/dev/null) respingeri)"
    exit 1
fi
# ── vechimea PREDARII (24.08.2026, cerut de Costin) ──────────────────────────
# Un /clear nu se poate garda din hook. Ce SE poate garda e commitul: daca HEAD a
# plecat cu mai mult de PRAG_PREDARE commituri de la ultima rescriere a predarii,
# poarta o SPUNE. Nu blocheaza — un blocaj pe fiecare commit ar face din predare
# un impozit pe reparatiile mici. Pragul suna ~o data pe zi de lucru.
PRAG_PREDARE=10
if git diff --cached --name-only | grep -qx "PREDARE_LANT.md"; then
    :   # se rescrie chiar acum
else
    ULT=$(git log -1 --format=%H -- PREDARE_LANT.md 2>/dev/null)
    if [ -n "$ULT" ]; then
        VECHI=$(git rev-list --count "$ULT"..HEAD 2>/dev/null || echo 0)
        if [ "$VECHI" -gt "$PRAG_PREDARE" ]; then
            echo "[pre-commit] ATENTIE: PREDARE_LANT.md e cu $VECHI commituri in urma lui HEAD (prag $PRAG_PREDARE)."
            echo "[pre-commit]   O predare statuta e mai rea decat una absenta: cine o citeste nu stie care rand mai e adevarat."
            echo "[pre-commit]   Rescrie-o inainte de oprire. Commitul NU e blocat."
        fi
    fi
fi

TOT=$("$PY" verificator_conformitate.py 2>&1 | grep -i "TOTAL")
echo "[pre-commit] verificator: $TOT"
case "$TOT" in
    *"TOTAL: 0"*) echo "[pre-commit] OK - poarta verde, commit permis." ; exit 0 ;;
    *) echo "[pre-commit] RESPINS: verificatorul nu da TOTAL 0." ;
       { echo "=== $(date -Is) RESPINS verificator"; echo "    $TOT";
         echo "    stage: $(git diff --cached --name-only | tr '\n' ' ' | cut -c1-160)";
       } >> "$ROOT/.poarta_jurnal.log" ;
       exit 1 ;;
esac

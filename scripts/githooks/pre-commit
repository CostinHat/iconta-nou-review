#!/bin/sh
# Poarta mecanica pre-commit (iConta) — numai verificarea RAPIDA a codului: ruff (nume nedefinite).
#
# [08.10.2026, decizia Costin pct.3] „Verificarea commit-msg rulează înaintea pytest, nu după.” SUITA INTREAGA (pytest) +
# verificator_conformitate.py s-au mutat de aici in `scripts/githooks/poarta-suita`, chemata de `commit-msg` DUPA verificarile
# mesajului (`scripts/githooks/verifica-mesaj`). Git ruleaza `pre-commit` INAINTEA mesajului (cu `git commit -F`,
# .git/COMMIT_EDITMSG poarta aici mesajul commitului PRECEDENT), deci o poarta care sta aici nu poate citi mesajul; un mesaj
# respins dupa ~55 de minute de pytest verde arunca toata rularea (06.10 si 08.10, platit de doua ori). Ordinea e acum:
# ruff (aici) -> mesajul (commit-msg / verifica-mesaj) -> pytest + verificatorul (commit-msg / poarta-suita).
# Suita ruleaza tot la FIECARE commit, MEREU, fara argumente si fara subset - nu se poate ocoli tastand alt pytest.
#
# Instalare (o singura data, per clona - .git/hooks NU intra in git):
#     git config core.hooksPath scripts/githooks
#
# De ce (31.07.2026): un `pytest && git commit` a lasat sa treaca un commit ROSU pentru ca pytest
# rulase pe un subset (doar core/). O poarta care depinde de ce comanda tastezi nu e poarta.
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
PY=./venv/bin/python
[ -x "$PY" ] || PY=python3
RUFF=./venv/bin/ruff
if [ -x "$RUFF" ]; then
    echo "[pre-commit] ruff (undefined-name F821/F822/F823)..."
    if ! "$RUFF" check . > /tmp/precommit_ruff.log 2>&1; then
        echo "[pre-commit] RESPINS: ruff a gasit nume nedefinite / crash latent (F821/F822/F823):"
        cat /tmp/precommit_ruff.log
        exit 1
    fi
    echo "[pre-commit] ruff OK."
else
    echo "[pre-commit] ATENTIE: ruff neinstalat in venv - poarta undefined-name (F821/F822/F823) SARITA. Ruleaza: ./venv/bin/pip install ruff"
fi

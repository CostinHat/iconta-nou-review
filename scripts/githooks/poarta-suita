#!/bin/sh
# POARTA SUITEI (iConta): probele de prospetime + pytest pe suita intreaga + verificator_conformitate.py + cifrele F1–F5 + plasa e2e.
# [15.10.2026, comanda Costin, verbatim in DECIZII „Poarta o dată pe lot”] Chemata NUMAI de `scripts/poarta_lot.sh`, o data pe lot, la
# inchiderea lui, pe commitul lotului (arbore curat); verdictul il scrie lansatorul, iar `reference-transaction` il cere la mutarea lui
# `main`. Pana pe 15.10 o chema `commit-msg` la fiecare commit (din 08.10, dupa verificarile mesajului); inainte, `pre-commit`.
# Gard: `core/test_poarta_ordine.py` (numai `poarta_lot.sh` o cheama).
#
# Respinge daca pytest nu iese 0, verificatorul nu da "TOTAL: 0", cifrele difera sau plasa pica.
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
# [15.10.2026] jurnalele porții: `POARTA_JURNALE` (testele îl mută într-un director al lor — conftest.py), implicit /tmp
J=${POARTA_JURNALE:-/tmp}
PY=./venv/bin/python
[ -x "$PY" ] || PY=python3
# ── VERDICTUL PRIVESTE COMMITUL (15.10.2026, prins dupa lotul 1 al regimului pilot) ──────────────────────────────────────
# pytest si verificatorul citesc ARBORELE DE LUCRU; commitul inregistreaza INDEXUL. Daca difera — un fisier modificat si nepus,
# unul nou neadaugat, sau o editare facuta CAT RULEAZA poarta (~70 de minute) — verdictul e despre altceva decat ce se comite:
# `fdb20bd6` a trecut poarta verde, iar exportul lui pica 9 garzi (DECIZII 15.10.2026 „Lotul 2”). Deci: la pornire arborele = indexul
# (fara modificari nepuse, fara fisiere noi neadaugate); la sfarsit, inaintea verdictului, fisierele urmarite sunt tot neschimbate.
arbore_nepus() { git diff --name-only; git ls-files --others --exclude-standard; }
NEPUS=$(arbore_nepus)
if [ -n "$NEPUS" ]; then
    echo "[poarta] RESPINS: arborele de lucru difera de ce se comite (poarta ar judeca altceva decat commitul):"
    echo "$NEPUS" | head -20 | sed 's/^/    /'
    echo "[poarta]   Pune la index pe NUME ce intra in commit; restul mutat in afara depozitului sau in .gitignore."
    exit 1
fi
# [15.10.2026] Ocolirea de curatenie (03.09.2026, `scripts/curatenie.py`) a iesit de aici: poarta ruleaza acum pe commitul lotului,
# cu arborele curat si indexul gol, iar pe index gol instrumentul raspunde mereu „nu e curatenie” — ramura ar fi fost cod mort. Marturia
# `# doar-curatenie:` din mesaj o cere in continuare `verifica-mesaj`, la commit.
# [16.09.2026] CIFRA, CORECTATA: scria „~32s" — statut de mult si fals cu trei ordine de
# marime. Masurat pe sase rulari consecutive: 2156-2216 s, adica ~36 de minute pentru ~6.190
# de teste. [08.10.2026] Remasurat: 3286,55 s (54:46) pe 7.637 de teste colectate (poarta lui 876e87a2). [11.10.2026] 3953 s (65:53) pe
# 8.021, iar poarta intreaga (pytest + verificator + cifre + plasa e2e de ~15 min, una dupa alta) ~82 de minute (e69198fb).
# ── IN PARALEL (11.10.2026, comanda Costin pct.4e, verbatim in DECIZII: „Fă poarta mai rapidă fără să scoți niciun test (de exemplu,
# rulare în paralel). Ținta: sub 30 de minute.”). Doua lucruri, fara niciun test scos (COLLECTED neschimbat):
#  1. pytest pe POARTA_PROCESE procese (pytest-xdist, implicit 3), `--dist loadfile`: testele unui fisier raman in acelasi proces, in
#     ordinea lor (fixture-urile de modul si starea dintre testele unui fisier nu se impart intre procese);
#  2. pytest porneste INTAI, in fundal; verificatorul si cifrele de referinta (productie, read-only) ruleaza IN ACELASI TIMP cu el, apoi
#     poarta asteapta pytest, si abia dupa verdictul lui porneste plasa e2e (aceeasi baza de test — v. mai jos de ce nu se suprapun).
#     O treapta rosie respinge commitul, ca inainte; numai asteptarea se suprapune.
#     Pe o treapta rosie poarta ASTEAPTA pytest inainte de a iesi (nu-l omoara): un test oprit la jumatate isi lasa datele.
# Fiecare durata se scrie in .poarta_jurnal.log (`DURATE`), si la verde, ca masuratoarea sa nu depinda de memoria cuiva.
# ── PROBELE DE PROSPETIME, INAINTEA SUITEI (15.10.2026, decizia Costin pct.1, verbatim in DECIZII „Lotul 3 — C35”: „Plus gard
# mecanic: poarta rulează probele de prospețime (pytest -k proaspat) înainte de suită.”). Poarta lotului 3 a fost respinsa dupa 50 de
# minute de doua artefacte de proba din browser ramase pe UI-ul vechi (`proba_pagina_principala.json`, `proba_decl50.json`) — un
# verdict care costa ~10 secunde. Testele care compara un artefact cu arborele (`ui_hash()` / `instrument_hash()`) poarta „proaspat”
# in nume — `core/test_poarta_proaspat.py` o cere —, deci le prinde selectia de mai jos. Rosu aici = commit respins INAINTEA suitei.
# (Fara `core/` — depozitele de proba ale testelor hook-urilor — nu e nimic de verificat.)
if [ -d core ]; then
    echo "[poarta] probele de prospetime (pytest -k proaspat), inaintea suitei..."
    "$PY" -m pytest -q -k proaspat core/ > $J/precommit_proaspat.log 2>&1
    RC_PROASPAT=$?
    tail -1 $J/precommit_proaspat.log
    if [ "$RC_PROASPAT" -ne 0 ]; then
        { echo "=== $(date -Is) RESPINS probe de prospetime exit $RC_PROASPAT"
          echo "    HEAD : $(git rev-parse --short HEAD 2>/dev/null)"
          grep -E "^(FAILED|ERROR) " $J/precommit_proaspat.log 2>/dev/null | sed "s/^/    /" | head -20
        } >> "$ROOT/.poarta_jurnal.log"
        echo "[poarta] RESPINS: un artefact de proba nu corespunde UI-ului / instrumentului de acum — regenereaza-l si pune-l la index."
        echo "[poarta]   Log: $J/precommit_proaspat.log"
        exit 1
    fi
fi
NW=${POARTA_PROCESE:-3}
T0=$(date +%s)
echo "[poarta] pytest (suita intreaga, $NW procese in paralel; verificatorul si cifrele ruleaza in acelasi timp, plasa dupa)..."
"$PY" -m pytest -q -n "$NW" --dist loadfile > $J/precommit_pytest.log 2>&1 &
PID_PYTEST=$!
RC_PYTEST=""
asteapta_pytest() {
    if [ -z "$RC_PYTEST" ]; then
        wait "$PID_PYTEST"
        RC_PYTEST=$?
        T_PYTEST=$(( $(date +%s) - T0 ))
    fi
}
inainte_de_respingere() {   # $1 = treapta; pytest se asteapta inainte de iesire (nu ramane orfan, nu-si lasa datele la jumatate)
    asteapta_pytest
    echo "    DURATE: pytest ${T_PYTEST}s (rc $RC_PYTEST) · poarta $(( $(date +%s) - T0 ))s · respinsa la: $1" >> "$ROOT/.poarta_jurnal.log"
}

TOT=$("$PY" verificator_conformitate.py 2>&1 | grep -i "TOTAL")
echo "[poarta] verificator: $TOT"
case "$TOT" in
    *"TOTAL: 0"*) : ;;
    *) echo "[poarta] RESPINS: verificatorul nu da TOTAL 0." ;
       { echo "=== $(date -Is) RESPINS verificator"; echo "    $TOT";
         echo "    commit: $(git rev-parse --short HEAD 2>/dev/null) pe $(git symbolic-ref --short HEAD 2>/dev/null)";
       } >> "$ROOT/.poarta_jurnal.log" ;
       inainte_de_respingere "verificator" ;
       exit 1 ;;
esac

# ── CIFRELE DE REFERINTA ALE FIRMELOR F1–F5 (10.10.2026, comanda Costin pct.1) ────────────────────────────────────────
# „Cifrele de referință [...] aprobate integral [...] Leagă gardul «orice diferență față de referință oprește publicarea». O schimbare
# voită se face doar cu aprobarea mea, consemnată în DECIZII.” Codul care se comite calculează balanța, D300, D394, D406 și D112 ale
# firmelor de test din producție (sesiune READ-ONLY, pe drumul aplicației) și le confruntă cu `scripts/cifre_referinta_aprobate.json`.
# Orice diferență -> RESPINS; orice eșec al măsurătorii -> RESPINS (fail-closed). Schimbarea voită a referinței: `verifica-mesaj`.
echo "[poarta] cifrele de referinta F1–F5 (productie, read-only) fata de referinta aprobata..."
"$PY" scripts/cifre_referinta.py --productie --verifica > $J/precommit_cifre.log 2>&1
RC=$?
tail -1 $J/precommit_cifre.log
if [ "$RC" -ne 0 ]; then
    { echo "=== $(date -Is) RESPINS cifre de referinta exit $RC"
      echo "    commit: $(git rev-parse --short HEAD 2>/dev/null) pe $(git symbolic-ref --short HEAD 2>/dev/null)"
      head -20 $J/precommit_cifre.log | sed "s/^/    /"
    } >> "$ROOT/.poarta_jurnal.log"
    echo "[poarta] RESPINS: cifrele de referinta difera sau nu s-au putut calcula. Log: $J/precommit_cifre.log"
    inainte_de_respingere "cifre"
    exit 1
fi

# ── pytest se ASTEAPTA AICI, INAINTEA plasei (11.10.2026, masurat): plasa porneste aplicatia pe ACEEASI baza de test pe care o folosesc
# testele, iar pornirea aplicatiei (lifespan) reface triggerele fiecarei firme (`DROP TRIGGER` + `CREATE TRIGGER`). Rulate simultan
# (proba din 11.10, 22:16): deadlock intre o pornire din pytest si aplicatia plasei care servea, pool-ul aplicatiei epuizat, plasa
# agatata doua ore. Pe baza de test, pytest si plasa NU se suprapun; se suprapun numai verificatorul si cifrele (productie read-only).
asteapta_pytest
tail -1 $J/precommit_pytest.log
RC=$RC_PYTEST
if [ "$RC" -ne 0 ]; then
    # JURNALUL PORTII (23.08.2026). Un test rosu OPRESTE commitul, omul repara, si ce ajunge in
    # istorie e deja verde - deci, PRIN CONSTRUCTIE, o garda care prinde o regresie nu lasa nicio
    # urma. Masurat: in 1.725 de commituri, patru citeaza un test, si toate patru repara TESTUL, nu
    # ceva prins de el. Intrebarea „a prins vreodata garda X o regresie reala?" n-avea cum sa aiba
    # raspuns. De aici incolo are: fiecare respingere se scrie, cu data, testele picate si CE ERA
    # IN STAGE (mesajul nu: suita nu-l primeste — l-a verificat deja `verifica-mesaj`). Jurnalul NU intra in istoric (e in .gitignore) - nu e un artefact de
    # versionat, e o urma care exista.
    JURNAL="$ROOT/.poarta_jurnal.log"
    {
        echo "=== $(date -Is) RESPINS pytest exit $RC"
        echo "    commit: $(git rev-parse --short HEAD 2>/dev/null) pe $(git symbolic-ref --short HEAD 2>/dev/null)"
        # NU se scrie mesajul commitului (pana pe 08.10 suita rula in pre-commit, unde .git/COMMIT_EDITMSG
        # purta mesajul commitului PRECEDENT — dovedit pe prima respingere reala, 23.08).
        echo "    HEAD : $(git rev-parse --short HEAD 2>/dev/null)"
        grep -E "^(FAILED|ERROR) " $J/precommit_pytest.log 2>/dev/null | sed "s/^/    /" | head -40
        tail -1 $J/precommit_pytest.log | sed "s/^/    /"
    } >> "$JURNAL"
    echo "[poarta] RESPINS: pytest exit $RC (suita rosie). Log complet: $J/precommit_pytest.log"
    echo "[poarta] consemnat in .poarta_jurnal.log ($(grep -c '^=== ' "$JURNAL" 2>/dev/null) respingeri)"
    inainte_de_respingere "pytest"
    exit 1
fi
# ── PLASA: testele de capat la capat ale deficientelor rezolvate (09.10.2026, comanda Costin pct.8) ──────────────
# „Proba unei deficiente «rezolvate» e un test de capat la capat in browser [...] Testul ramane permanent in poarta.” si regula
# de directie: „orice publicare la care pica o verificare a plasei nu se face”. Aplicatia porneste din INDEX (exact ce se
# comite), pe baza de test, port 8019; testele sunt `frontend_test/e2e/e2e_*.py`. Rosu = commit respins, ca pytest-ul.
echo "[poarta] plasa: testele de capat la capat ale deficientelor (browser, aplicatia din index)..."
T_E2E0=$(date +%s)
"$PY" scripts/e2e_poarta.py /tmp/e2e_poarta_capturi > $J/precommit_e2e.log 2>&1
RC=$?
tail -1 $J/precommit_e2e.log
if [ "$RC" -ne 0 ]; then
    { echo "=== $(date -Is) RESPINS plasa e2e exit $RC"
      echo "    commit: $(git rev-parse --short HEAD 2>/dev/null) pe $(git symbolic-ref --short HEAD 2>/dev/null)"
      grep -E "^(FAILED|ERROR) " $J/precommit_e2e.log | sed "s/^/    /" | head -40
    } >> "$ROOT/.poarta_jurnal.log"
    echo "[poarta] RESPINS: plasa e2e exit $RC. Log: $J/precommit_e2e.log, capturi: /tmp/e2e_poarta_capturi"
    inainte_de_respingere "plasa e2e"
    exit 1
fi
T_E2E=$(( $(date +%s) - T_E2E0 ))

# [15.10.2026] arborele urmarit, neschimbat cat a rulat poarta (v. „VERDICTUL PRIVESTE COMMITUL” sus)
NEPUS=$(git diff --name-only)
if [ -n "$NEPUS" ]; then
    echo "[poarta] RESPINS: fisiere urmarite schimbate CAT a rulat poarta — verdictul nu mai e despre ce se comite:"
    echo "$NEPUS" | head -20 | sed 's/^/    /'
    exit 1
fi

# ── vechimea PREDARII (24.08.2026, cerut de Costin) ──────────────────────────
# Un /clear nu se poate garda din hook. Ce SE poate garda e commitul: daca HEAD a
# plecat cu mai mult de PRAG_PREDARE commituri de la ultima rescriere a predarii,
# poarta o SPUNE. Nu blocheaza — un blocaj pe fiecare commit ar face din predare
# un impozit pe reparatiile mici. Pragul suna ~o data pe zi de lucru.
PRAG_PREDARE=10
if git diff --cached --name-only | grep -qx "PREDARE_LANT.md"; then
    :   # se rescrie chiar acum
else
    ULT=$(git log -1 --format=%H -- PREDARE_LANT.md 2>/dev/null)
    if [ -n "$ULT" ]; then
        VECHI=$(git rev-list --count "$ULT"..HEAD 2>/dev/null || echo 0)
        if [ "$VECHI" -gt "$PRAG_PREDARE" ]; then
            echo "[poarta] ATENTIE: PREDARE_LANT.md e cu $VECHI commituri in urma lui HEAD (prag $PRAG_PREDARE)."
            echo "[poarta]   O predare statuta e mai rea decat una absenta: cine o citeste nu stie care rand mai e adevarat."
            echo "[poarta]   Rescrie-o inainte de oprire. Commitul NU e blocat."
        fi
    fi
fi

echo "    DURATE: $(date -Is) VERDE · pytest ${T_PYTEST}s (verificator+cifre simultan) · plasa ${T_E2E}s (dupa pytest) · poarta $(( $(date +%s) - T0 ))s" >> "$ROOT/.poarta_jurnal.log"
echo "[poarta] durata: pytest ${T_PYTEST}s · plasa ${T_E2E}s · poarta $(( $(date +%s) - T0 ))s"
echo "[poarta] OK - poarta verde (verdictul il scrie scripts/poarta_lot.sh)."
exit 0

#!/bin/sh
# commit-msg (iConta): NUMAI verificarile mesajului. Suita NU mai ruleaza la commit.
#
# [15.10.2026, comanda Costin, verbatim in DECIZII „Poarta o dată pe lot”] „Poarta completă: o singură dată pe lot, la închiderea
# lotului, înainte de publicarea pe producție. [...] Muți poarta din hook-ul commit-msg pe mutarea lui main, cum ai propus: main
# acceptă un commit doar dacă jurnalul porții îl arată verde.” Supersedeaza 08.10.2026 pct.3 (mesajul, apoi suita, la fiecare commit).
# Poarta completa se porneste NUMAI din `scripts/poarta_lot.sh` (inchiderea lotului) -> `poarta-suita`; verdictul ei, scris in
# `<git-common-dir>/poarta_verdicte.log`, il cere `reference-transaction` la mutarea lui `main`.
#
#   `verifica-mesaj` — fisierele noi numite, defectul cu loc, fisierele normative citite, curatenia declarata, octetii de control.
# Gard: `core/test_poarta_ordine.py` (commit-msg nu porneste suita; `poarta-suita` e chemata numai de `poarta_lot.sh`).
DIR=$(dirname "$0")
sh "$DIR/verifica-mesaj" "$1" || exit 1
exit 0

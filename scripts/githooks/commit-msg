#!/bin/sh
# commit-msg (iConta): INTAI verificarile mesajului, APOI suita.
#
# [08.10.2026, decizia Costin pct.3] „Verificarea commit-msg rulează înaintea pytest, nu după. Intră în acest lot, nu separat.”
# Instanta care a cerut-o: pe 06.10 si din nou pe 08.10 o poarta VERDE de ~55 de minute a fost aruncata de verificarea
# mesajului (lipsea `# diff-citit:`), fiindca suita statea in `pre-commit`, iar git ruleaza `pre-commit` inaintea mesajului.
# Regula „treci mesajul intai manual prin hook" a fost ignorata si platita de doua ori; ce n-a tinut ca disciplina devine aici
# ordine: un mesaj respins costa acum secunde, nu o rulare.
#
#   1. `verifica-mesaj` — fisierele noi numite, defectul cu loc, fisierele normative citite, curatenia declarata, octetii de
#      control. Respinge -> commitul se opreste AICI, inainte de pytest.
#   2. `poarta-suita` — pytest pe suita intreaga + verificatorul (sarita numai la un commit de curatenie, decis de
#      `scripts/curatenie.py` din INDEX).
# Gard: `core/test_poarta_ordine.py` (ordinea, ca structura si ca efect).
DIR=$(dirname "$0")
sh "$DIR/verifica-mesaj" "$1" || exit 1
sh "$DIR/poarta-suita" || exit 1
exit 0
